<!--
  ⚠️ This file is generated. Do not edit README.md directly.
  Edit profile.yml / projects.yml instead — see HOW_TO_UPDATE.md.
-->

<div align="center">

<picture>
  <source media="(prefers-color-scheme: dark)" srcset="assets/banner-dark.svg">
  <img src="assets/banner-light.svg" alt="{{ profile.name }} — {{ profile.role }}" width="100%">
</picture>

{% if typing_url %}
<img src="{{ typing_url }}" alt="{{ profile.typing_lines | join(' · ') }}">
{% endif %}

{% for badge in contact_badges %}<a href="{{ badge.href }}"><img src="{{ badge.img }}" alt="{{ badge.label }}"></a>{% if not loop.last %}&nbsp;{% endif %}{% endfor %}


</div>

{% if profile.about %}
## 👋 About me

{% for line in profile.about %}
- {{ line }}
{% endfor %}
{% endif %}

{% if featured %}
## 🚀 Featured projects

<table>
{% for row in featured | batch(2) %}
  <tr>
{% for p in row %}
    <td width="50%" valign="top">
{% if p.image %}
      <a href="{{ p.primary_link }}"><img src="{{ p.image }}" alt="{{ p.name }} screenshot" width="100%"></a>
{% endif %}
      <h3><a href="{{ p.primary_link }}">{{ p.name }}</a></h3>
      <p>{{ p.description }}</p>
      <p>{% for t in p.tech_badges %}<img src="{{ t.img }}" alt="{{ t.label }}"> {% endfor %}</p>
      <p>{% if p.repo %}<a href="{{ p.repo }}"><b>Code</b></a>{% endif %}{% if p.repo and p.demo %} · {% endif %}{% if p.demo %}<a href="{{ p.demo }}"><b>Live demo</b></a>{% endif %}</p>
    </td>
{% endfor %}
{% if row | length == 1 %}
    <td width="50%"></td>
{% endif %}
  </tr>
{% endfor %}
</table>
{% endif %}

{% if more %}
## 📂 More projects

<details open>
<summary><b>{{ more | length }} more project{{ 's' if more | length != 1 }}</b></summary>
<br>

| Project | Description | Tech |
| --- | --- | --- |
{% for p in more %}
| {% if p.primary_link %}[**{{ p.name }}**]({{ p.primary_link }}){% else %}**{{ p.name }}**{% endif %}{% if p.demo and p.repo %} · [demo]({{ p.demo }}){% endif %} | {{ p.description | replace('|', '\\|') }} | {{ p.tech | join(', ') }} |
{% endfor %}

</details>
{% endif %}

{% if tech_groups %}
## 🛠️ Tech stack

{% for group in tech_groups %}
**{{ group.name }}**<br>
{% for t in group.badges %}<img src="{{ t.img }}" alt="{{ t.label }}"> {% endfor %}


{% endfor %}
{% endif %}

{% if profile.theme.show_stats %}
## 📊 GitHub stats

<div align="center">

<picture>
  <source media="(prefers-color-scheme: dark)" srcset="{{ stats.stats_dark }}">
  <img src="{{ stats.stats_light }}" alt="GitHub stats" height="165">
</picture>
<picture>
  <source media="(prefers-color-scheme: dark)" srcset="{{ stats.langs_dark }}">
  <img src="{{ stats.langs_light }}" alt="Top languages" height="165">
</picture>

<picture>
  <source media="(prefers-color-scheme: dark)" srcset="{{ stats.streak_dark }}">
  <img src="{{ stats.streak_light }}" alt="GitHub streak">
</picture>

</div>
{% endif %}

